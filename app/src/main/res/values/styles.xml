<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ButtonMainActivity" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/medium_font</item>
        <item name="android:layout_margin">8dp</item>
        <item name="cornerRadius">@dimen/bt_radius</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="iconTint">@color/black</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="LinearLayoutTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">8dp</item>
    </style>
    <style name="ButtonBackTitle">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:src">@drawable/ic_back_arrow_24</item>
        <item name="android:layout_margin">12dp</item>
    </style>
    <style name="LinearLayoutStandard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>    
    </style>
    <style name="LinearLayoutMain" parent="LinearLayoutStandard">
        <item name="android:background">@color/yp_blue</item>
    </style>
    <style name="LinearLayoutSettings" parent="LinearLayoutStandard">
        <item name="android:background">@color/white</item>
    </style>
    <style name="TextViewTitleCommon">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_marginLeft">12dp</item>
    </style>
    <style name="TextViewTitle" parent="TextViewTitleCommon">
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="TextViewMenuCommon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_gravity">start|center</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextViewMenu" parent="TextViewMenuCommon">
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="FrameLayoutMenu">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="ImageViewMenu">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">end|center_vertical</item>
    </style>
    <style name="SearchEditTextCommon">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingTop">8.5dp</item>
        <item name="android:paddingBottom">8.5dp</item>
        <item name="android:lines">1</item>
        <item name="android:hint">@string/bt_find</item>
        <item name="android:inputType">text</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="android:drawableStart">@drawable/ic_search_16</item>
        <item name="android:drawablePadding">7dp</item>
        <item name="android:paddingStart">13dp</item>
        <item name="paddingEnd">48dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>
    <style name="SearchEditText" parent="SearchEditTextCommon">
        <item name="android:textColorHint">@color/yp_text_gray</item>
    </style>
    <style name="ItemViewImage">
        <item name="android:layout_width">45dp</item>
        <item name="android:layout_height">45dp</item>
        <item name="android:layout_marginStart">13dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="ItemViewTitleCommon">
        <item name="android:layout_width">250dp</item>
        <item name="android:layout_height">19dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="ItemViewTitle" parent="ItemViewTitleCommon">
        <item name="android:textColor">@color/yp_black</item>
    </style>
    <style name="ItemViewInfoCommon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="ItemViewInfo" parent="ItemViewInfoCommon">
        <item name="android:textColor">@color/yp_text_gray</item>
    </style>
    <style name="RvTrack">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="layoutManager">androidx.recyclerview.widget.LinearLayoutManager</item>
        <item name="android:orientation">vertical</item>
    </style>
</resources>